# Скопируйте этот файл в .env и заполните значения из консоли Firebase
# Firebase Console: https://console.firebase.google.com
# Project settings -> Your apps -> Web app -> SDK setup

VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# S3-ключи аккаунта Archive.org (https://archive.org/account/s3.php).
# Используются клиентом для прямой загрузки битов. Попадают в JS-бандл —
# рекомендуем завести отдельный «издательский» аккаунт archive.org.
VITE_ARCHIVE_ORG_ACCESS_KEY=your-s3-access-key
VITE_ARCHIVE_ORG_SECRET_KEY=your-s3-secret-key
