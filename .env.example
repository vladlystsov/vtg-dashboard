# Скопируйте этот файл в .env и заполните значения из консоли Firebase
# Firebase Console: https://console.firebase.google.com
# Project settings -> Your apps -> Web app -> SDK setup

VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
# Web Push (браузер): Web Push certificates в Firebase → Project settings → Cloud Messaging
VITE_FIREBASE_VAPID_KEY=your-web-push-vapid-key
# Адрес функции отправки push (по умолчанию /api/push-send на Vercel)
VITE_PUSH_PROXY_URL=
# Абсолютный URL app-meta.json на задеплоенном сайте. Нативное приложение
# сравнивает свою версию (versionName из build.gradle) с этой, чтобы показать
# «Доступно обновление»: внутри APK лежит локальная копия файла, которая
# всегда равна установленной версии. По умолчанию
# https://vladlystsov.github.io/vtg-dashboard/app-meta.json
VITE_APP_LATEST_URL=

# Хранилище файлов: Backblaze B2. Ключи читает только serverless-функция
# api/b2-storage.mjs (в браузерный бандл не попадают). Задаются и в Vercel.
# B2_KEY_ID=...
# B2_APP_KEY=...
# B2_BUCKET_NAME=vtg-storage
# B2_REGION=eu-central-003
# Постоянная база ссылок на файлы (полный URL функции) — для приватного бакета:
# B2_LINK_BASE=https://<project>.vercel.app/api/b2-storage
# Полный URL прокси-функции (нужен, если SPA на GitHub Pages):
# VITE_B2_PROXY_URL=https://<project>.vercel.app/api/b2-storage
# Полный URL прокси-функции импорта каналов YouTube/YouTube Music
# (api/youtube-rss.mjs). Нужен, если SPA на GitHub Pages:
# VITE_YOUTUBE_PROXY_URL=https://<project>.vercel.app/api/youtube-rss
# Runtime-переменные для serverless-функции api/b2-storage.mjs (проверка Firebase
# ID-токенов и роли). Без префикса VITE_ — иначе Vercel не отдаст их в функцию:
# FIREBASE_API_KEY=AIza...
# FIREBASE_PROJECT_ID=vtg-dashboard

# Настройка CORS на бакете B2 (выполнить после изменения ключей или региона):
# npm run b2:setup-cors
# Скрипт api/b2-setup-cors.mjs применяет CORS-правила к обоим API B2:
# - S3-совместимый API (через AWS SDK)
# - B2 собственный API (через b2_set_bucket_cors)
# Правила разрешают: GET/HEAD (чтение), PUT/POST (загрузка), OPTIONS (preflight)
# со всех доменов (*).
