rules_version = '2';
service firebase.storage {
  function userRole() {
    return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role;
  }
  function isAdmin() {
    return request.auth != null && userRole() in ['admin', 'owner'];
  }
  function isBeatmaker() {
    return request.auth != null && userRole() in ['admin', 'owner', 'beatmaker'];
  }

  match /b/{bucket}/o {
    match /covers/{trackId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Биты (mp3 до 30 МБ) — загружают админы/битмейкеры
    match /beats/{fileName} {
      allow read: if request.auth != null;
      allow create: if isBeatmaker() && request.resource.size <= 30 * 1024 * 1024;
      allow update, delete: if isAdmin();
    }

    // Демо/мастер mp3 треков (до 30 МБ)
    match /tracks/{fileName} {
      allow read: if request.auth != null;
      allow create: if isBeatmaker() && request.resource.size <= 30 * 1024 * 1024;
      allow update, delete: if isAdmin();
    }

    // Zip-архивы проектов (до 1 ГБ)
    match /projects/{fileName} {
      allow read: if request.auth != null;
      allow create: if isBeatmaker() && request.resource.size <= 1024 * 1024 * 1024;
      allow update, delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow list: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }
  }
}